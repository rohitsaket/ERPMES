generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema", "fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ORG HIERARCHY MODELS (Workflow 1, 2, 9)
// ============================================

model Company {
  id         String    @id @default(cuid())
  name       String
  code       String    @unique
  settings   Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  branches    Branch[]
  factories   Factory[]
  warehouses  Warehouse[]
  departments Department[]
  workCenters WorkCenter[]
  users       User[]

  @@index([code])
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  address   Json?
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company   Company   @relation(fields: [companyId], references: [id])
  factories Factory[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Factory {
  id        String   @id @default(cuid())
  companyId String
  branchId  String?
  name      String
  code      String
  capacity  Json?    @default("{}")
  shifts    Json?    @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company     Company       @relation(fields: [companyId], references: [id])
  branch      Branch?       @relation(fields: [branchId], references: [id])
  warehouses  Warehouse[]
  departments Department[]
  workCenters WorkCenter[]

  @@unique([companyId, code])
  @@index([companyId, branchId])
}

model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  factoryId String?
  name      String
  code      String
  type      String   @default("standard")
  location  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company   Company?       @relation(fields: [companyId], references: [id])
  factory   Factory?       @relation(fields: [factoryId], references: [id])
  lots      InventoryLot[]
  zones     WarehouseZone[]

  @@unique([companyId, code])
  @@index([companyId, factoryId])
}

model WarehouseZone {
  id          String   @id @default(cuid())
  warehouseId String
  name        String
  code        String
  type        String   @default("storage")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, code])
}

model Department {
  id        String   @id @default(cuid())
  companyId String
  factoryId String?
  name      String
  code      String
  type      String
  sequence  Int?
  capacity  Int      @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company      Company?       @relation(fields: [companyId], references: [id])
  factory      Factory?       @relation(fields: [factoryId], references: [id])
  workCenters  WorkCenter[]
  operations   Operation[]

  @@unique([companyId, factoryId, code])
  @@index([companyId, factoryId])
}

model WorkCenter {
  id           String   @id @default(cuid())
  companyId    String
  factoryId    String?
  departmentId String
  name         String
  code         String
  type         String
  capacity     Int      @default(1)
  oeeTarget    Float    @default(0.85)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  company    Company?     @relation(fields: [companyId], references: [id])
  factory    Factory?     @relation(fields: [factoryId], references: [id])
  department Department   @relation(fields: [departmentId], references: [id])
  operations Operation[]

  @@unique([companyId, departmentId, code])
  @@index([companyId, factoryId, departmentId])
}

model User {
  id         String    @id @default(cuid())
  companyId  String?
  branchId   String?
  factoryId  String?
  deptId     String?
  clerkId    String    @unique
  email      String    @unique
  firstName  String?
  lastName   String?
  role       String    @default("operator")
  permissions Json     @default("[]")
  settings   Json      @default("{}")
  lastLogin  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  sessions   Session[]

  @@index([companyId])
  @@index([clerkId])
  company    Company?  @relation(fields: [companyId], references: [id])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  device     Json?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name])
}

// ============================================
// MASTER DATA MODELS (Workflow 1, 3, 4, 5)
// ============================================

model Product {
  id          String   @id @default(cuid())
  companyId   String
  sku         String
  name        String
  description String?
  category    String
  type        String   @default("finished")
  uom         String   @default("PCS")
  weight      Decimal? @db.Decimal(10, 4)
  imageUrl    String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  boms     Bom[]
  routings Routing[]

  @@unique([companyId, sku])
  @@index([companyId, category])
}

model Bom {
  id        String   @id @default(cuid())
  companyId String
  productId String
  version   Int      @default(1)
  status    String   @default("active")
  effectiveDate DateTime?
  expiryDate DateTime?
  createdAt DateTime @default(now())
  createdBy String?
  approvedAt DateTime?
  approvedBy String?

  product Product   @relation(fields: [productId], references: [id])
  lines   BomLine[]

  @@unique([productId, version])
  @@index([companyId, productId])
}

model BomLine {
  id          String   @id @default(cuid())
  bomId       String
  itemId      String
  qty         Decimal  @db.Decimal(12, 4)
  uom         String   @default("PCS")
  operationSeq Int?
  scrapPct    Float    @default(0.0)
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bom Bom @relation(fields: [bomId], references: [id])

  @@index([bomId])
}

model Routing {
  id          String   @id @default(cuid())
  companyId   String
  productId   String
  version     Int      @default(1)
  name        String
  status      String   @default("active")
  effectiveDate DateTime?
  expiryDate DateTime?
  createdAt   DateTime @default(now())
  createdBy   String?
  approvedAt  DateTime?
  approvedBy  String?

  product      Product         @relation(fields: [productId], references: [id])
  operations   RoutingOp[]
  configs      RoutingConfig[]

  @@unique([productId, version])
  @@index([companyId, productId])
}

model RoutingOp {
  id              String   @id @default(cuid())
  routingId       String
  seq             Int
  departmentId    String
  workCenterType  String
  name            String
  description     String?
  setupMin        Int      @default(0)
  runMinPerUnit   Float    @default(0.0)
  queueMin        Int      @default(0)
  moveMin         Int      @default(0)
  inspectionPlanId String?
  requiredSkill   String?
  requiredTool    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  routing Routing @relation(fields: [routingId], references: [id])

  @@unique([routingId, seq])
  @@index([routingId])
}

model RoutingConfig {
  id                  String   @id @default(cuid())
  routingId           String
  companyId           String?
  factoryId           String?
  productId           String?
  diamondType         String?
  shape               String?
  customerId          String?
  orderType           String?
  manufacturingMethod String?
  priority            String?
  qualityReq          String?
  departmentSequence  Json
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  routing Routing @relation(fields: [routingId], references: [id])

  @@index([routingId])
}

model Customer {
  id           String   @id @default(cuid())
  companyId    String
  code         String
  name         String
  type         String   @default("individual")
  contactInfo  Json?
  address      Json?
  taxId        String?
  creditLimit  Decimal? @db.Decimal(14, 2)
  paymentTerms String   @default("NET30")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  salesOrders SalesOrder[]
  quotations  Quotation[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Vendor {
  id           String   @id @default(cuid())
  companyId    String
  code         String
  name         String
  type         String   @default("supplier")
  contactInfo  Json?
  address      Json?
  taxId        String?
  paymentTerms String   @default("NET30")
  leadTimeDays Int      @default(7)
  rating       Float    @default(3.0)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  purchaseOrders PurchaseOrder[]
  rfqs           Rfq[]

  @@unique([companyId, code])
  @@index([companyId])
}

// ============================================
// SALES MODELS (Workflow 1)
// ============================================

model Quotation {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  number      String   @unique
  version     Int      @default(1)
  status      String   @default("draft")
  validUntil  DateTime?
  notes       String?
  totalAmount Decimal? @db.Decimal(14, 2)
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  createdBy   String?
  approvedAt  DateTime?
  approvedBy  String?
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  customer   Customer       @relation(fields: [customerId], references: [id])
  lines      QuotationLine[]
  approval   QuotationApproval?
  salesOrders SalesOrder[]

  @@index([companyId, customerId])
  @@index([number])
}

model QuotationLine {
  id           String   @id @default(cuid())
  quotationId  String
  productId    String
  diamondSpec  Json?
  qty          Int      @default(1)
  uom          String   @default("PCS")
  unitPrice    Decimal  @db.Decimal(12, 4)
  discountPct  Float    @default(0.0)
  lineTotal    Decimal  @db.Decimal(14, 2)
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@index([quotationId])
}

model QuotationApproval {
  id          String   @id @default(cuid())
  quotationId String   @unique
  status      String   @default("pending")
  currentStep Int      @default(1)
  history     Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id])
}

model SalesOrder {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  quotationId String?
  number      String   @unique
  status      String   @default("draft")
  priority    String   @default("normal")
  currency    String   @default("USD")
  totalAmount Decimal? @db.Decimal(14, 2)
  notes       String?
  requestedDate DateTime
  promisedDate  DateTime?
  createdAt   DateTime @default(now())
  createdBy   String?
  validatedAt DateTime?
  releasedAt  DateTime?
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  customer   Customer        @relation(fields: [customerId], references: [id])
  quotation  Quotation?      @relation(fields: [quotationId], references: [id])
  lines      SalesOrderLine[]
  allocations DiamondAllocation[]
  creditCheck CreditCheck?
  invoice    Invoice?
  shipment   Shipment?

  @@index([companyId, customerId])
  @@index([number])
  @@index([status])
}

model SalesOrderLine {
  id               String   @id @default(cuid())
  salesOrderId     String
  productId        String
  qty              Int      @default(1)
  uom              String   @default("PCS")
  unitPrice        Decimal  @db.Decimal(12, 4)
  discountPct      Float    @default(0.0)
  lineTotal        Decimal  @db.Decimal(14, 2)
  allocatedQty     Int      @default(0)
  productionOrderId String?
  dueDate          DateTime?
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])

  @@index([salesOrderId])
}

model CreditCheck {
  id           String   @id @default(cuid())
  salesOrderId String   @unique
  status       String   @default("pending")
  creditLimit  Decimal? @db.Decimal(14, 2)
  currentBalance Decimal? @db.Decimal(14, 2)
  riskScore    Float?
  notes        String?
  checkedAt    DateTime @default(now())
  checkedBy    String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
}

// ============================================
// PLANNING MODELS (Workflow 3)
// ============================================

model MrpRun {
  id               String   @id @default(cuid())
  companyId        String
  status           String   @default("running")
  recordsProcessed Int      @default(0)
  exceptions       Json     @default("[]")
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  errorDetails     Json?
  createdAt        DateTime @default(now())

  plannedOrders PlannedOrder[]

  @@index([companyId, status])
}

model PlannedOrder {
  id         String   @id @default(cuid())
  mrpRunId   String
  companyId  String
  itemId     String
  qty        Decimal  @db.Decimal(12, 4)
  uom        String   @default("PCS")
  dueDate    DateTime
  supplyType String   @default("purchase")
  pegging    Json?
  status     String   @default("suggested")
  createdAt  DateTime @default(now())

  mrpRun MrpRun @relation(fields: [mrpRunId], references: [id])

  @@index([mrpRunId, companyId])
}

model ProductionOrder {
  id             String   @id @default(cuid())
  companyId      String
  salesOrderLineId String?
  productId      String
  routingId      String
  number         String   @unique
  qty            Int      @default(1)
  uom            String   @default("PCS")
  status         String   @default("planned")
  priority       String   @default("normal")
  plannedStartDate DateTime?
  plannedEndDate DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  createdBy      String?
  releasedAt     DateTime?
  completedAt    DateTime?
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  operations  ProductionOrderOp[]
  jobCards    JobCard[]

  @@index([companyId, salesOrderLineId])
  @@index([number])
  @@index([status])
}

model ProductionOrderOp {
  id              String   @id @default(cuid())
  productionOrderId String
  seq             Int
  departmentId    String
  workCenterId    String?
  routingOpId     String?
  status          String   @default("queued")
  setupMin        Int      @default(0)
  runMin          Float    @default(0.0)
  qtyCompleted    Int      @default(0)
  qtyScrap        Int      @default(0)
  weightIn        Decimal? @db.Decimal(10, 4)
  weightOut       Decimal? @db.Decimal(10, 4)
  yieldPct        Float?
  startedAt       DateTime?
  completedAt     DateTime?
  operatorId      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id])

  @@unique([productionOrderId, seq])
  @@index([productionOrderId, departmentId, workCenterId])
}

model JobCard {
  id               String   @id @default(cuid())
  productionOrderId String
  operationSeq     Int
  status           String   @default("pending")
  assignedTo       String?
  issuedAt         DateTime?
  completedAt      DateTime?
  packetId         String?
  diamondIds       Json?    @default("[]")
  barcode          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id])

  @@unique([productionOrderId, operationSeq])
  @@index([productionOrderId])
}

model CapacityRequirement {
  id           String   @id @default(cuid())
  companyId    String
  factoryId    String?
  workCenterId String
  periodStart  DateTime
  periodEnd    DateTime
  requiredHours Float
  availableHours Float
  loadPct      Float
  notes        String?
  createdAt    DateTime @default(now())

  @@index([companyId, factoryId, workCenterId, periodStart])
}

// ============================================
// PROCUREMENT MODELS (Workflow 1)
// ============================================

model PurchaseRequisition {
  id          String   @id @default(cuid())
  companyId   String
  number      String   @unique
  status      String   @default("draft")
  requestedBy String?
  requestedDate DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  lines PrLine[]

  @@index([companyId])
}

model PrLine {
  id         String   @id @default(cuid())
  reqId      String
  itemId     String
  qty        Decimal  @db.Decimal(12, 4)
  uom        String   @default("PCS")
  neededBy   DateTime
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  requisition PurchaseRequisition @relation(fields: [reqId], references: [id])

  @@index([reqId])
}

model Rfq {
  id          String   @id @default(cuid())
  companyId   String
  vendorId    String
  number      String   @unique
  status      String   @default("draft")
  dueDate     DateTime
  notes       String?
  createdAt   DateTime @default(now())
  sentAt      DateTime?
  updatedAt   DateTime @updatedAt

  vendor Vendor       @relation(fields: [vendorId], references: [id])
  lines  RfqLine[]

  @@index([companyId, vendorId])
}

model RfqLine {
  id       String   @id @default(cuid())
  rfqId    String
  itemId   String
  qty      Decimal  @db.Decimal(12, 4)
  uom      String   @default("PCS")
  unitPrice Decimal? @db.Decimal(12, 4)
  remarks  String?
  createdAt DateTime @default(now())

  rfq Rfq @relation(fields: [rfqId], references: [id])

  @@index([rfqId])
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  companyId   String
  vendorId    String
  requisitionId String?
  number      String   @unique
  status      String   @default("draft")
  currency    String   @default("USD")
  totalAmount Decimal? @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime @default(now())
  createdBy   String?
  approvedAt  DateTime?
  approvedBy  String?
  sentAt      DateTime?
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  vendor       Vendor             @relation(fields: [vendorId], references: [id])
  lines        PoLine[]
  goodsReceipt GoodsReceipt[]

  @@index([companyId, vendorId])
  @@index([number])
}

model PoLine {
  id           String   @id @default(cuid())
  poId         String
  itemId       String
  qty          Decimal  @db.Decimal(12, 4)
  uom          String   @default("PCS")
  unitPrice    Decimal  @db.Decimal(12, 4)
  lineTotal    Decimal  @db.Decimal(14, 2)
  dueDate      DateTime?
  receivedQty  Decimal  @default(0.0) @db.Decimal(12, 4)
  status       String   @default("open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])

  @@index([poId])
}

model GoodsReceipt {
  id          String   @id @default(cuid())
  companyId   String
  poId        String
  warehouseId String
  number      String   @unique
  status      String   @default("received")
  receivedBy  String?
  receivedAt  DateTime @default(now())
  inspectedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  lines         GrLine[]

  @@index([companyId, poId])
}

model GrLine {
  id               String   @id @default(cuid())
  goodsReceiptId   String
  poLineId         String
  qty              Decimal  @db.Decimal(12, 4)
  uom              String   @default("PCS")
  lotId            String?
  inspectionStatus String   @default("pending")
  inspectionNotes  String?
  createdAt        DateTime @default(now())

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])

  @@index([goodsReceiptId])
}

// ============================================
// INVENTORY MODELS (Workflow 1, 2)
// ============================================

model InventoryLot {
  id            String   @id @default(cuid())
  companyId     String
  factoryId     String?
  warehouseId   String
  zoneId        String?
  itemId        String
  lotNumber     String
  qty           Decimal  @db.Decimal(12, 4)
  uom           String   @default("PCS")
  status        String   @default("available")
  expiryDate    DateTime?
  certificateId String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  transactions InventoryTransaction[]
  reservations Reservation[]

  @@unique([companyId, lotNumber])
  @@index([companyId, warehouseId, itemId])
  @@index([status])
  warehouse  Warehouse? @relation(fields: [warehouseId], references: [id])
}

model InventoryTransaction {
  id           String   @id @default(cuid())
  companyId    String
  lotId        String
  type         String
  qty          Decimal  @db.Decimal(12, 4)
  uom          String   @default("PCS")
  refType      String?
  refId        String?
  fromLocation String?
  toLocation   String?
  operatorId   String?
  weightBefore Decimal? @db.Decimal(10, 4)
  weightAfter  Decimal? @db.Decimal(10, 4)
  notes        String?
  createdAt    DateTime @default(now())

  lot InventoryLot @relation(fields: [lotId], references: [id])

  @@index([companyId, lotId, createdAt])
  @@index([refType, refId])
}

model Reservation {
  id               String   @id @default(cuid())
  companyId        String
  lotId            String
  salesOrderLineId String
  productionOrderId String?
  qty              Decimal  @db.Decimal(12, 4)
  uom              String   @default("PCS")
  status           String   @default("active")
  expiresAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lot InventoryLot @relation(fields: [lotId], references: [id])

  @@index([companyId, lotId])
  @@index([salesOrderLineId])
}

model InventorySnapshot {
  id          String   @id @default(cuid())
  companyId   String
  factoryId   String?
  warehouseId String
  itemId      String
  qty         Decimal  @db.Decimal(12, 4)
  uom         String   @default("PCS")
  snapshotDate DateTime @default(now())
  source       String
  createdAt    DateTime @default(now())

  @@index([companyId, warehouseId, snapshotDate])
}

model ErpSyncRecord {
  id                String   @id @default(cuid())
  companyId         String
  connector         String
  externalRequestId String?
  externalIdentifier String?
  mappingVersion    String   @default("1.0")
  importMode        String   @default("delta")
  recordsReceived   Int      @default(0)
  recordsAccepted   Int      @default(0)
  recordsRejected   Int      @default(0)
  conflicts         Json     @default("[]")
  retries           Int      @default(0)
  status            String   @default("running")
  correlationId     String?
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  errorDetails      Json?
  reconciliationResult Json?

  @@index([companyId, connector, startedAt])
  @@index([status])
}

model PhysicalCount {
  id          String   @id @default(cuid())
  companyId   String
  warehouseId String
  number      String   @unique
  status      String   @default("open")
  createdBy   String?
  createdAt   DateTime @default(now())
  approvedAt  DateTime?
  approvedBy  String?
  updatedAt   DateTime @updatedAt

  lines CountLine[]

  @@index([companyId, warehouseId])
}

model CountLine {
  id              String   @id @default(cuid())
  physicalCountId String
  lotId           String
  systemQty       Decimal  @db.Decimal(12, 4)
  countedQty      Decimal? @db.Decimal(12, 4)
  varianceQty     Decimal? @db.Decimal(12, 4)
  variancePct     Float?
  countedBy       String?
  countedAt       DateTime?
  notes           String?
  createdAt       DateTime @default(now())

  physicalCount PhysicalCount @relation(fields: [physicalCountId], references: [id])

  @@index([physicalCountId])
}

// ============================================
// DIAMONDS MODELS (Workflow 1, 4, 7)
// ============================================

model Diamond {
  id              String   @id @default(cuid())
  companyId       String
  certificateNo   String?  @unique
  carat           Decimal  @db.Decimal(8, 4)
  color           String?
  clarity         String?
  cut             String?
  shape           String   @default("round")
  origin          String?
  status          String   @default("unallocated")
  currentOwnerId  String?
  currentPacketId String?
  currentDeptId   String?
  currentEmployeeId String?
  currentMachineId String?
  parentDiamondId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  genealogy   DiamondEvent[]
  allocations DiamondAllocation[]
  certificate DiamondCertificate?
  packet      DiamondPacket?     @relation("PacketDiamonds", fields: [currentPacketId], references: [id])
  bag         Bag?               @relation("BagDiamonds", fields: [id], references: [id])

  @@index([companyId, status])
  @@index([currentPacketId])
  @@index([currentDeptId])
}

model DiamondPacket {
  id        String   @id @default(cuid())
  companyId String
  factoryId String?
  name      String
  barcode   String?
  status    String   @default("open")
  bagId     String?
  notes     String?
  createdAt DateTime @default(now())
  sealedAt  DateTime?
  updatedAt DateTime @updatedAt

  diamonds Diamond[] @relation("PacketDiamonds")

  @@index([companyId, factoryId])
  @@index([status])
}

model DiamondEvent {
  id             String   @id @default(cuid())
  companyId      String
  diamondId      String
  eventType      String
  fromDeptId     String?
  toDeptId       String?
  packetId       String?
  employeeId     String?
  operationId    String?
  weightBefore   Decimal? @db.Decimal(10, 4)
  weightAfter    Decimal? @db.Decimal(10, 4)
  lossPct        Float?
  timestamp      DateTime @default(now())
  notes          String?
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now())

  diamond Diamond @relation(fields: [diamondId], references: [id])

  @@index([companyId, diamondId, timestamp])
  @@index([companyId, eventType, timestamp])
}

model DiamondAllocation {
  id               String   @id @default(cuid())
  companyId        String
  diamondId        String
  salesOrderId     String
  salesOrderLineId String?
  productionOrderId String?
  status           String   @default("allocated")
  allocatedAt      DateTime @default(now())
  consumedAt       DateTime?
  notes            String?

  diamond     Diamond    @relation(fields: [diamondId], references: [id])
  salesOrder  SalesOrder @relation(fields: [salesOrderId], references: [id])

  @@index([companyId, diamondId])
  @@index([salesOrderId, salesOrderLineId])
}

model DiamondCertificate {
  id            String   @id @default(cuid())
  diamondId     String   @unique
  companyId     String
  labId         String
  certificateNo String   @unique
  issueDate     DateTime?
  expiryDate    DateTime?
  reportUrl     String?
  reportJson    Json?
  validatedAt   DateTime?
  validatedBy   String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  diamond Diamond @relation(fields: [diamondId], references: [id])
}

// ============================================
// MANUFACTURING MODELS (Workflow 4)
// ============================================

model Operation {
  id               String   @id @default(cuid())
  companyId        String
  factoryId        String?
  productionOrderId String
  productionOrderOpId String?
  departmentId     String
  workCenterId     String?
  employeeId       String?
  jobCardId        String?
  status           String   @default("queued")
  weightIn         Decimal? @db.Decimal(10, 4)
  weightOut        Decimal? @db.Decimal(10, 4)
  yieldPct         Float?
  qtyGood          Int      @default(0)
  qtyScrap         Int      @default(0)
  startedAt        DateTime?
  pausedAt         DateTime?
  resumedAt        DateTime?
  transferredAt    DateTime?
  completedAt      DateTime?
  totalPauseMin    Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  department Department?  @relation(fields: [departmentId], references: [id])
  workCenter WorkCenter?  @relation(fields: [workCenterId], references: [id])

  @@index([companyId, factoryId, departmentId, status])
  @@index([productionOrderId, status])
  @@index([workCenterId, status])
}

model WorkCenterQueue {
  id           String   @id @default(cuid())
  companyId    String
  workCenterId String   @unique
  ops          Json     @default("[]")
  updatedAt    DateTime @updatedAt

  @@index([companyId, workCenterId])
}

model DepartmentTransfer {
  id             String   @id @default(cuid())
  companyId      String
  fromDeptId     String
  toDeptId       String
  operationId    String
  packetId       String?
  diamondIds     Json     @default("[]")
  weightTransferred Decimal? @db.Decimal(10, 4)
  transferredBy  String?
  transferredAt  DateTime @default(now())
  acceptedAt     DateTime?
  acceptedBy     String?
  status         String   @default("pending")
  notes          String?
  createdAt      DateTime @default(now())

  @@index([companyId, operationId])
  @@index([fromDeptId, toDeptId])
}

// ============================================
// QUALITY MODELS (Workflow 6, 7)
// ============================================

model InspectionPlan {
  id        String   @id @default(cuid())
  companyId String
  productId String
  routingOpId String?
  version   Int      @default(1)
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps InspectionStep[]

  @@unique([companyId, productId, version])
  @@index([companyId])
}

model InspectionStep {
  id              String   @id @default(cuid())
  planId          String
  seq             Int
  name            String
  type            String   @default("variable")
  specMin         Decimal? @db.Decimal(12, 6)
  specMax         Decimal? @db.Decimal(12, 6)
  target          Decimal? @db.Decimal(12, 6)
  uom             String   @default("MM")
  method          String?
  samplingPlan    Json     @default("{\"type\": \"100%\",\"sampleSize\":0}")
  requiredImage   Boolean  @default(false)
  entryMode       String   @default("manual")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan InspectionPlan @relation(fields: [planId], references: [id])

  @@unique([planId, seq])
}

model QualityInspection {
  id               String   @id @default(cuid())
  companyId        String
  operationId      String
  productionOrderId String
  planId           String
  stepId           String
  inspectorId      String?
