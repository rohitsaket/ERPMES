  companyId   String
  diamondId   String
  labId       String
  status      String   @default("pending")
  submittedAt DateTime?
  trackingNo  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, diamondId])
  @@index([status])
}

model Certificate {
  id           String   @id @default(cuid())
  companyId    String
  diamondId    String   @unique
  labId        String
  certificateNo String  @unique
  reportDate   DateTime?
  issueDate    DateTime?
  expiryDate   DateTime?
  gradingData  Json?
  reportUrl    String?
  pdfUrl       String?
  validatedAt  DateTime?
  validatedBy  String?
  status       String   @default("received")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, diamondId])
  @@index([labId])
}

// ============================================
// MAINTENANCE MODELS (Workflow 1)
// ============================================

model Asset {
  id           String   @id @default(cuid())
  companyId    String
  factoryId    String?
  name         String
  code         String
  assetType    String   @default("machine")
  departmentId String?
  workCenterId String?
  modelNumber  String?
  serialNumber String?
  manufacturer String?
  installDate  DateTime?
  warrantyExp  DateTime?
  criticality  String   @default("medium")
  status       String   @default("active")
  pmScheduleId String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workOrders    WorkOrder[]
  pmSchedule PreventiveMaintenanceSchedule? @relation("AssetPmSchedule", fields: [pmScheduleId], references: [id])
  sparePartLinks AssetSparePart[]

  @@unique([companyId, factoryId, code])
  @@index([companyId, factoryId])
}

model PreventiveMaintenanceSchedule {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  frequencyType String
  frequencyValue Int
  tasks         Json     @default("[]")
  estimatedHours Float?
  requiresShutdown Boolean @default(false)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assets Asset[] @relation("AssetPmSchedule")

  @@index([companyId])
}

model WorkOrder {
  id            String   @id @default(cuid())
  companyId     String
  assetId       String
  type          String   @default("repair")
  priority      String   @default("medium")
  status        String   @default("open")
  description   String
  assignedTo    String?
  dueDate       DateTime?
  estimatedHours Float?
  actualHours   Float?
  downtimeMin   Int      @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  createdBy     String?
  updatedAt     DateTime @updatedAt

  asset Asset  @relation(fields: [assetId], references: [id])
  tasks WoTask[]

  @@index([companyId, assetId, status])
}

model WoTask {
  id              String   @id @default(cuid())
  workOrderId     String
  seq             Int
  description     String
  type            String   @default("inspection")
  estimatedHours  Float?
  actualHours     Float?
  completedAt     DateTime?
  completedBy     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@unique([workOrderId, seq])
}

model AssetSparePart {
  id          String   @id @default(cuid())
  assetId     String
  partNumber  String
  partName    String
  minStockQty Int      @default(1)
  currentStockQty Int  @default(0)
  unitCost    Decimal? @db.Decimal(12, 4)
  vendorId    String?
  createdAt   DateTime @default(now())

  asset  Asset  @relation(fields: [assetId], references: [id])

  @@unique([assetId, partNumber])
}

// ============================================
// DISPATCH MODELS (Workflow 1)
// ============================================

model Bag {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  barcode     String?
  sealNo      String?
  status      String   @default("open")
  weight      Decimal? @db.Decimal(10, 4)
  shipmentId  String?
  diamondIds  Json     @default("[]")
  sealedAt    DateTime?
  sealedBy    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  diamonds  Diamond[]  @relation("BagDiamonds")
  shipment  Shipment?  @relation(fields: [shipmentId], references: [id])

  @@index([companyId, shipmentId])
}

model Shipment {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  salesOrderId String? @unique
  carrierId   String?
  number      String   @unique
  trackingNo  String?
  status      String   @default("planned")
  weight      Decimal? @db.Decimal(10, 4)
  value       Decimal? @db.Decimal(14, 2)
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  signedBy     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bags      Bag[]
  trackingEntries ShipmentTracking[]

  @@index([companyId, customerId])
  @@index([trackingNo])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])

}

model ShipmentTracking {
  id          String   @id @default(cuid())
  shipmentId  String
  status      String
  location    String?
  timestamp   DateTime
  rawData     Json?    @default("{}")
  createdAt   DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId, timestamp])
}

model Carrier {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  code        String
  apiConfig   Json?
  serviceLevels Json?  @default("[]")
  rateSheetUrls Json? @default("[]")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
}

model DispatchPlan {
  id          String   @id @default(cuid())
  companyId   String
  factoryId   String?
  name        String
  status      String   @default("draft")
  plannedDate DateTime
  shipments   Json     @default("[]")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, factoryId])
}

// ============================================
// FINANCE MODELS (Workflow 1)
// ============================================

model ChartOfAccount {
  id          String   @id @default(cuid())
  companyId   String
  code        String
  name        String
  type        String   @default("asset")
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
}

model Invoice {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  salesOrderId String? @unique
  shipmentId  String?
  number      String   @unique
  status      String   @default("draft")
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("USD")
  taxAmount   Decimal? @db.Decimal(14, 2)
  dueDate     DateTime?
  sentAt      DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@index([companyId, customerId])
  @@index([status])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])

}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  qty         Int      @default(1)
  uom         String   @default("PCS")
  unitPrice   Decimal  @db.Decimal(12, 4)
  lineTotal   Decimal  @db.Decimal(14, 2)
  taxCode     String?
  accountId   String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(cuid())
  companyId   String
  invoiceId   String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("USD")
  method      String   @default("bank_transfer")
  reference   String?
  receivedAt  DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([companyId, invoiceId])
}

model JournalEntry {
  id          String   @id @default(cuid())
  companyId   String
  number      String   @unique
  date        DateTime @default(now())
  memo        String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines JournalLine[]

  @@index([companyId, date])
}

model JournalLine {
  id              String   @id @default(cuid())
  journalEntryId  String
  accountId       String
  debit           Decimal? @db.Decimal(14, 2)
  credit          Decimal? @db.Decimal(14, 2)
  description     String?
  createdAt       DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])

  @@index([journalEntryId])
}

// ============================================
// RETURNS MODELS (Workflow 8)
// ============================================

model ReturnAuthorization {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  invoiceId   String?
  number      String   @unique
  type        String   @default("return")
  status      String   @default("pending")
  reason      String?
  authorizedAt DateTime?
  authorizedBy String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines    RaLine[]
  receipt  ReturnReceipt?
  repair   RepairOrder?

  @@index([companyId, customerId])
  @@index([status])
}

model RaLine {
  id       String   @id @default(cuid())
  raId     String
  diamondId String?
  qty      Int      @default(1)
  reason   String?
  createdAt DateTime @default(now())

  returnAuth ReturnAuthorization @relation(fields: [raId], references: [id])

  @@index([raId])
}

model ReturnReceipt {
  id               String   @id @default(cuid())
  companyId        String
  returnAuthId     String   @unique
  receivedAt       DateTime @default(now())
  receivedBy       String?
  inspectionStatus String   @default("pending")
  inspectionNotes  String?
  disposition      String?
  createdAt        DateTime @default(now())

  returnAuth ReturnAuthorization @relation(fields: [returnAuthId], references: [id])
}

model RepairOrder {
  id               String   @id @default(cuid())
  companyId        String
  returnAuthId     String   @unique
  productionOrderId String?
  status           String   @default("pending")
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  returnAuth ReturnAuthorization @relation(fields: [returnAuthId], references: [id])
  redispatch Redispatch?
}

model Redispatch {
  id            String   @id @default(cuid())
  companyId     String
  repairOrderId String   @unique
  shipmentId    String?
  status        String   @default("pending")
  dispatchedAt  DateTime?
  notes         String?
  createdAt     DateTime @default(now())

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id])
}

// ============================================
// WORKFLOW MODELS (Cross-cutting)
