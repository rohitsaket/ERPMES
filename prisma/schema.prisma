  measurementValue Decimal? @db.Decimal(12, 6)
  result           String?
  imageUrls        Json?    @default("[]")
  timestamp        DateTime @default(now())
  ncrId            String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ncr Nonconformance?

  @@index([companyId, operationId])
  @@index([productionOrderId, status])
}

model Nonconformance {
  id               String   @id @default(cuid())
  companyId        String
  inspectionId     String   @unique
  type             String   @default("defect")
  severity         String   @default("major")
  disposition      String?
  dispositionedBy  String?
  dispositionedAt  DateTime?
  rootCause        String?
  correctiveAction String?
  capaId           String? @unique
  status           String   @default("open")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inspection QualityInspection @relation(fields: [inspectionId], references: [id])
  capa       CorrectiveAction? @relation(fields: [capaId], references: [id])


  @@index([companyId, inspectionId])
  @@index([status])
}

model CorrectiveAction {
  id          String   @id @default(cuid())
  companyId   String
  ncrId       String   @unique
  description String
  type        String   @default("corrective")
  ownerId     String?
  dueDate     DateTime?
  status      String   @default("open")
  completedAt DateTime?
  verifiedAt  DateTime?
  verifiedBy  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ncr Nonconformance?
}

model CertificationRequest {
