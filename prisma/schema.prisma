  category    String
  title       String
  body        String
  entityType  String?
  entityId    String?
  isRead      Boolean  @default(false)
  readAt      DateTime?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([companyId, userId, isRead])
  @@index([userId, createdAt])
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  category    String
  channel     String   @default("email")
  subject     String
  body        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name, channel])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  enabled     Boolean  @default(false)
  rolloutPct  Int      @default(100)
  companyIds  Json?    @default("[]")
  conditions  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookConfig {
  id          String   @id @default(cuid())
  companyId   String
  eventType   String
  url         String
  secret      String
  isActive    Boolean  @default(true)
  retries     Int      @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, eventType])
}
