{
  "name": "@diamondflow/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "pnpm --workspace-root nx run @diamondflow/api:build && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/clerk-sdk-node": "^5.0.0",
    "@diamondflow/auth": "workspace:*",
    "@diamondflow/authorization": "workspace:*",
    "@diamondflow/contracts": "workspace:*",
    "@diamondflow/database": "workspace:*",
    "@diamondflow/events": "workspace:*",
    "@diamondflow/observability": "workspace:*",
    "@diamondflow/queue": "workspace:*",
    "@diamondflow/realtime": "workspace:*",
    "@nestjs/bullmq": "10.2.1",
    "@nestjs/common": "10.3.8",
    "@nestjs/config": "3.2.2",
    "@nestjs/core": "10.3.8",
    "@nestjs/event-emitter": "2.0.2",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.3.8",
    "@nestjs/platform-socket.io": "10.3.8",
    "@nestjs/swagger": "7.3.1",
    "@nestjs/terminus": "10.1.0",
    "@nestjs/websockets": "10.4.5",
    "@prisma/client": "5.22.0",
    "bullmq": "5.11.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cls-rtracer": "2.6.0",
    "decimal.js": "10.4.0",
    "ioredis": "5.4.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.7.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "prisma": "5.22.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node"
  }
}
